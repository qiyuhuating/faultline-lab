{
  "name": "faultline-lab",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A local, observable task engine for testing retries, idempotency and process-crash recovery.",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "benchmark": "node tools/benchmark.mjs",
    "check": "node tools/check.mjs && tsc -p tsconfig.json && node tools/check-architecture.mjs",
    "test:types": "tsc -p tests/tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"tests/types/*.ts\" \"tools/check-architecture.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/types/*.ts\" \"tools/check-architecture.mjs\""
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
